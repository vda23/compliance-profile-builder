# Пример обратного прокси для Compliance Profile Builder.
# Разместить в /etc/nginx/sites-available/, сделать симлинк в sites-enabled.
#
# С версии install.sh 2.0 сервис по умолчанию сам поднимает HTTPS
# (самоподписанный сертификат или свой, см. --cert/--key), поэтому nginx
# перед ним не обязателен. Он остаётся полезен в двух случаях:
#   а) вы хотите завершать TLS на nginx своим сертификатом от корпоративного
#      CA/сервиса выпуска сертификатов, а бэкенд поднят локально по HTTP
#      (установка с --no-tls) — см. первый пример ниже;
#   б) вам нужен единый вход (домен, балансировка) перед несколькими
#      внутренними HTTPS-сервисами — см. второй пример (проксирование на
#      HTTPS-бэкенд с самоподписанным сертификатом).

# --- Вариант А: TLS терминируется на nginx, бэкенд поднят с --no-tls -------
server {
    listen 443 ssl;
    server_name profiles.example.local;

    ssl_certificate     /etc/ssl/certs/profiles.example.local.crt;
    ssl_certificate_key /etc/ssl/private/profiles.example.local.key;

    client_max_body_size 20m;  # на случай импорта крупных ZIP-архивов

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name profiles.example.local;
    return 301 https://$host$request_uri;
}

