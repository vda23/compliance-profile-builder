    {
      "id": "password.minlen",
      "title": "Минимальная длина пароля",
      "description": "Проверяется, что параметр minlen в /etc/security/pwquality.conf задаёт длину пароля не меньше требуемой.",
      "rationale": "Короткий пароль подбирается перебором за приемлемое время, поэтому минимальная длина задаётся политикой и контролируется автоматически.",
      "category": "Парольная политика",
      "keywords": [
        "пароль",
        "длина пароля",
        "парольная защита",
        "сложность пароля",
        "идентификация",
        "аутентификация"
      ],
      "platforms": {
        "family": "unix",
        "os": [
          "Astra Linux",
          "Debian",
          "Ubuntu",
          "РЕД ОС",
          "ALT Linux",
          "SberLinux"
        ]
      },
      "params": [
        {
          "name": "pattern",
          "title": "Допустимые значения (регулярное выражение)",
          "default": "^(1[4-9]|[2-9][0-9]|[0-9]{3,})$",
          "datatype": "string"
        }
      ],
      "check": {
        "type": "ind:textfilecontent54_test",
        "object": {
          "path": "/etc/security",
          "filename": "pwquality.conf",
          "pattern": "^[[:space:]]*minlen[[:space:]]*=[[:space:]]*([0-9]+)"
        },
        "state": {
          "subexpression": {
            "value": "{{pattern}}",
            "operation": "pattern match",
            "datatype": "string"
          }
        },
        "check": "all",
        "check_existence": "at_least_one_exists"
      },
      "remediation": "В файле /etc/security/pwquality.conf задать minlen = 14 (или иное значение согласно политике)."
    },
