{
  "pack": "linux-base",
  "title": "Базовые проверки конфигурации Linux",
  "description": "Типовые технические проверки защищённости для Debian-подобных и RPM-подобных систем. Состав опирается на общепринятые практики усиления конфигурации (CIS Benchmark и аналоги). Номера пунктов конкретных документов здесь не проставлены — они подставляются на этапе сопоставления с загруженным нормативным документом.",
  "checks": [
    {
      "id": "ssh.permit_root_login",
      "title": "Запрет входа суперпользователя по SSH",
      "description": "Проверяется, что параметр PermitRootLogin в /etc/ssh/sshd_config имеет значение no.",
      "rationale": "Прямой вход суперпользователя по сети лишает систему персональной ответственности: в журналах не видно, кто именно выполнял действия. Администраторы должны входить под своими учётными записями и повышать права отдельно.",
      "category": "Удалённый доступ",
      "keywords": [
        "ssh",
        "root",
        "суперпользователь",
        "удалённый доступ",
        "вход",
        "аутентификация",
        "привилегированный"
      ],
      "platforms": {
        "family": "unix",
        "os": [
          "Astra Linux",
          "Debian",
          "Ubuntu",
          "РЕД ОС",
          "ALT Linux",
          "SberLinux"
        ]
      },
      "params": [
        {
          "name": "value",
          "title": "Ожидаемое значение",
          "default": "no",
          "datatype": "string"
        }
      ],
      "check": {
        "type": "ind:textfilecontent54_test",
        "object": {
          "path": "/etc/ssh",
          "filename": "sshd_config",
          "pattern": "^[[:space:]]*PermitRootLogin[[:space:]]+([a-zA-Z-]+)"
        },
        "state": {
          "subexpression": {
            "value": "^{{value}}$",
            "operation": "pattern match",
            "datatype": "string"
          }
        },
        "check": "all",
        "check_existence": "at_least_one_exists"
      },
      "remediation": "В файле /etc/ssh/sshd_config задать PermitRootLogin no и перезапустить службу sshd."
    },
    {
      "id": "ssh.permit_empty_passwords",
      "title": "Запрет входа по SSH с пустым паролем",
      "description": "Проверяется, что параметр PermitEmptyPasswords в /etc/ssh/sshd_config имеет значение no.",
      "rationale": "Учётная запись с пустым паролем делает удалённый доступ открытым для любого, кто знает имя пользователя.",
      "category": "Удалённый доступ",
      "keywords": [
        "ssh",
        "пустой пароль",
        "аутентификация",
        "удалённый доступ",
        "парольная защита"
      ],
      "platforms": {
        "family": "unix",
        "os": [
          "Astra Linux",
          "Debian",
          "Ubuntu",
          "РЕД ОС",
          "ALT Linux",
          "SberLinux"
        ]
      },
      "params": [
        {
          "name": "value",
          "title": "Ожидаемое значение",
          "default": "no",
          "datatype": "string"
        }
      ],
      "check": {
        "type": "ind:textfilecontent54_test",
        "object": {
          "path": "/etc/ssh",
          "filename": "sshd_config",
          "pattern": "^[[:space:]]*PermitEmptyPasswords[[:space:]]+([a-zA-Z-]+)"
        },
        "state": {
          "subexpression": {
            "value": "^{{value}}$",
            "operation": "pattern match",
            "datatype": "string"
          }
        },
        "check": "all",
        "check_existence": "at_least_one_exists"
      },
      "remediation": "В файле /etc/ssh/sshd_config задать PermitEmptyPasswords no и перезапустить службу sshd."
    },
    {
      "id": "ssh.max_auth_tries",
      "title": "Ограничение числа попыток аутентификации по SSH",
      "description": "Проверяется, что параметр MaxAuthTries в /etc/ssh/sshd_config не превышает заданного значения.",
      "rationale": "Ограничение попыток в рамках одного соединения замедляет подбор пароля и делает попытки подбора заметными в журнале.",
      "category": "Удалённый доступ",
      "keywords": [
        "ssh",
        "подбор пароля",
        "попытки аутентификации",
        "перебор",
        "блокировка"
