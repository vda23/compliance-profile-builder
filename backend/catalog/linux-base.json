          "Ubuntu",
          "РЕД ОС",
          "ALT Linux",
          "SberLinux"
        ]
      },
      "params": [
        {
          "name": "pattern",
          "title": "Допустимые значения (регулярное выражение)",
          "default": "^[1-4]$",
          "datatype": "string"
        }
      ],
      "check": {
        "type": "ind:textfilecontent54_test",
        "object": {
          "path": "/etc/ssh",
          "filename": "sshd_config",
          "pattern": "^[[:space:]]*MaxAuthTries[[:space:]]+([0-9]+)"
        },
        "state": {
          "subexpression": {
            "value": "{{pattern}}",
            "operation": "pattern match",
            "datatype": "string"
          }
        },
        "check": "all",
        "check_existence": "at_least_one_exists"
      },
      "remediation": "В файле /etc/ssh/sshd_config задать MaxAuthTries 4 или меньше и перезапустить службу sshd."
    },
    {
